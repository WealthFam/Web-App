# --------------------------------------------------------------------------------
# WealthFam - Frontend (Vite) Configuration
# --------------------------------------------------------------------------------

# Backend API URL (for frontend to connect to)
VITE_API_URL=http://localhost:8000/api/v1

# Telemetry Configuration
# Optional: Set to 'true' to completely disable client-side telemetry collection
VITE_DISABLE_TELEMETRY=false
# Optional: Target URL for telemetry ingestion (defaults to relative '/telemetry')
VITE_TELEMETRY_URL=/telemetry
